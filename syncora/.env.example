# Firebase Console → Project settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulators (no real project needed)
# VITE_USE_EMULATORS=true

# ---- Payments (CloudPayments) ----
VITE_CP_PUBLIC_ID=
# Widget script; ask CloudPayments which one applies to your merchant account
# VITE_CP_WIDGET_URL=https://widget.cloudpayments.ru/bundles/cloudpayments.js

# ---- Seller details shown on /legal/* pages (required by payment providers) ----
# e.g. ИП «Фамилия Аты» or ТОО «...»
VITE_LEGAL_NAME=
VITE_LEGAL_BIN=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SITE_URL=https://syncora.kz
